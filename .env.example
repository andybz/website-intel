# PostgreSQL connection string used by the app and drizzle-kit
DATABASE_URL=postgres://website_intel:website_intel_dev@localhost:5432/website_intel

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Resend (https://resend.com) - used to send password-reset emails.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@andybz.com

# OpenAI (https://platform.openai.com) - used for AI issue summaries.
OPENAI_API_KEY=
